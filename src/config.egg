// otel/config: where spans go and how, set in code or by the environment
// variables every OpenTelemetry SDK reads (OTEL_SERVICE_NAME,
// OTEL_EXPORTER_OTLP_ENDPOINT, OTEL_EXPORTER_OTLP_HEADERS, ...), so the
// same settings send an Egg program's spans where a Go or Python one's go.
uses alloc, args

const text = @import("std/text")

// service names this program (service.name). endpoint is the OTLP/HTTP
// base, http:// or https://: spans go to endpoint/v1/traces, or to
// traces_endpoint as it is when that is set. headers go with every
// request, as OTEL_EXPORTER_OTLP_HEADERS writes them: "key=value" pairs
// split by commas, percent-encoded ("Authorization=Bearer%20abc", or with
// the space as it is). batch spans go in one request, at most interval_ms
// apart while there are any; queue is how many may wait for the exporter
// before more are dropped; timeout_ms bounds each request; ratio is the
// share of new traces sampled (a span with a parent follows the parent's
// choice); disabled, nothing sampled at all, parent or not
// (OTEL_SDK_DISABLED).
const Config = struct {
    service: str
    endpoint: str
    traces_endpoint: str
    headers: str
    batch: i64
    queue: i64
    interval_ms: i64
    timeout_ms: i64
    ratio: f64
    disabled: bool
}

// The defaults of OTel's batch span processor and OTLP exporter.
fn config(service: str) Config {
    return Config{ .service = service, .endpoint = "http://localhost:4318", .traces_endpoint = "", .headers = "", .batch = 512, .queue = 2048, .interval_ms = 5000, .timeout_ms = 10000, .ratio = 1.0, .disabled = false }
}

// config(service), then whatever the OpenTelemetry environment variables
// set: OTEL_SERVICE_NAME; OTEL_EXPORTER_OTLP_ENDPOINT,
// OTEL_EXPORTER_OTLP_HEADERS, OTEL_EXPORTER_OTLP_TIMEOUT and their
// TRACES_ forms, which win; OTEL_BSP_SCHEDULE_DELAY, OTEL_BSP_MAX_QUEUE_SIZE,
// OTEL_BSP_MAX_EXPORT_BATCH_SIZE; OTEL_TRACES_SAMPLER (always_on,
// always_off, traceidratio and their parentbased_ forms: a child always
// follows its parent here) with OTEL_TRACES_SAMPLER_ARG; and
// OTEL_SDK_DISABLED=true, which samples nothing, not even a child of a
// sampled parent. A value that does not
// parse is ignored, as the spec asks. OTEL_EXPORTER_OTLP_PROTOCOL is not
// read: spans go as http/json, which every OTLP/HTTP receiver takes.
fn config_from_env(env: Args, service: str) Config {
    var c = config(service)
    const names = [13]str{ "OTEL_SERVICE_NAME", "OTEL_EXPORTER_OTLP_ENDPOINT", "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT", "OTEL_EXPORTER_OTLP_HEADERS", "OTEL_EXPORTER_OTLP_TRACES_HEADERS", "OTEL_EXPORTER_OTLP_TIMEOUT", "OTEL_EXPORTER_OTLP_TRACES_TIMEOUT", "OTEL_BSP_SCHEDULE_DELAY", "OTEL_BSP_MAX_QUEUE_SIZE", "OTEL_BSP_MAX_EXPORT_BATCH_SIZE", "OTEL_TRACES_SAMPLER", "OTEL_TRACES_SAMPLER_ARG", "OTEL_SDK_DISABLED" }
    var sampler: str = ""
    var arg: str = ""
    var disabled: str = ""
    for (names) |name| {
        if (env.env(name)) |v| {
            if (name == "OTEL_TRACES_SAMPLER") {
                sampler = v
            } else if (name == "OTEL_TRACES_SAMPLER_ARG") {
                arg = v
            } else if (name == "OTEL_SDK_DISABLED") {
                disabled = v
            } else {
                _ = apply(&c, name, v)
            }
        }
    }
    settle(&c, sampler, arg, disabled)
    return c
}

// The sampler, and OTEL_SDK_DISABLED beside it: disabled samples
// nothing, whatever the sampler, and whatever a parent chose.
fn settle(inout c: Config, sampler: []u8, arg: []u8, disabled: []u8) void {
    _ = sample(&c, sampler, arg)
    if (is_true(disabled)) {
        c.disabled = true
    }
}

// One environment variable's setting into c (not the sampler's, which
// sample takes): false if it is not one, or its value does not parse.
fn apply(inout c: Config, name: []u8, v: str) bool {
    if (name == "OTEL_SERVICE_NAME") {
        if (@len(v) == 0) {
            return false
        }
        c.service = v
    } else if (name == "OTEL_EXPORTER_OTLP_ENDPOINT" or name == "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT") {
        // One that is not a URL leaves what was there, which may be good.
        if (!endpoint_ok(v)) {
            return false
        }
        if (name == "OTEL_EXPORTER_OTLP_ENDPOINT") {
            c.endpoint = v
        } else {
            c.traces_endpoint = v
        }
    } else if (name == "OTEL_EXPORTER_OTLP_HEADERS" or name == "OTEL_EXPORTER_OTLP_TRACES_HEADERS") {
        // The TRACES_ form, read after, replaces these, if it parses.
        if (!headers_ok(v)) {
            return false
        }
        c.headers = v
    } else if (name == "OTEL_SDK_DISABLED") {
        if (is_true(v)) {
            c.disabled = true
        }
    } else {
        const n = text.parse_int(text.strip(v)) orelse return false
        if (n < 0 or (n == 0 and name != "OTEL_EXPORTER_OTLP_TIMEOUT" and name != "OTEL_EXPORTER_OTLP_TRACES_TIMEOUT")) {
            return false
        }
        if (name == "OTEL_EXPORTER_OTLP_TIMEOUT" or name == "OTEL_EXPORTER_OTLP_TRACES_TIMEOUT") {
            c.timeout_ms = n
        } else if (name == "OTEL_BSP_SCHEDULE_DELAY") {
            c.interval_ms = n
        } else if (name == "OTEL_BSP_MAX_QUEUE_SIZE") {
            c.queue = n
        } else if (name == "OTEL_BSP_MAX_EXPORT_BATCH_SIZE") {
            c.batch = n
        } else {
            return false
        }
    }
    return true
}

// OTEL_TRACES_SAMPLER and its argument into c.ratio: false for a sampler
// this SDK does not have, or a ratio outside 0 to 1, which leave it.
fn sample(inout c: Config, sampler: []u8, arg: []u8) bool {
    const s = text.strip(sampler)
    if (@len(s) == 0) {
        return true
    }
    if (s == "always_on" or s == "parentbased_always_on") {
        c.ratio = 1.0
        return true
    }
    if (s == "always_off" or s == "parentbased_always_off") {
        c.ratio = 0.0
        return true
    }
    if (s == "traceidratio" or s == "parentbased_traceidratio") {
        if (@len(text.strip(arg)) == 0) {
            c.ratio = 1.0
            return true
        }
        const r = text.parse_float(text.strip(arg)) orelse return false
        if (r < 0.0 or r > 1.0) {
            return false
        }
        c.ratio = r
        return true
    }
    return false
}

// Where spans go: traces_endpoint as it is, or endpoint with /v1/traces
// at the end of its path (one slash between, whatever the path ends
// with), before any ?query or #fragment it has.
fn traces_url(a: Allocator, c: Config) Buf(u8) {
    if (@len(c.traces_endpoint) > 0) {
        return a.concat(c.traces_endpoint, "")
    }
    const base = c.endpoint
    var lo = 0
    var end = @len(base)
    while (lo < end and (base[lo] == ' ' or base[lo] == '\t')) {
        lo = lo + 1
    }
    while (end > lo and (base[end - 1] == ' ' or base[end - 1] == '\t')) {
        end = end - 1
    }
    // The path ends at the query or the fragment, past the scheme's "//".
    var path_end = end
    const from = (text.find_from(base[0..end], "//", lo) orelse lo - 2) + 2
    var i = from
    while (i < end) {
        if (base[i] == '?' or base[i] == '#') {
            path_end = i
            break
        }
        i = i + 1
    }
    var hi = path_end
    while (hi > from and base[hi - 1] == '/') {
        hi = hi - 1
    }
    return a.concat(base[lo..hi], "/v1/traces", base[path_end..end])
}

// "true" in any case, as OTel reads its booleans, spaces around it aside.
fn is_true(v: []u8) bool {
    const t = text.strip(v)
    if (@len(t) != 4) {
        return false
    }
    const want = "true"
    var i = 0
    while (i < 4) {
        if (lower(t[i]) != want[i]) {
            return false
        }
        i = i + 1
    }
    return true
}

fn lower(c: u8) u8 {
    return if (c >= 'A' and c <= 'Z') c + 32 else c
}

// http:// or https:// (any case) and a host after it: enough to tell a
// URL from a mistake before the exporter is pointed at it.
fn endpoint_ok(v: []u8) bool {
    const t = text.strip(v)
    var n = 0
    if (@len(t) > 7 and starts_ci(t, "http://")) {
        n = 7
    } else if (@len(t) > 8 and starts_ci(t, "https://")) {
        n = 8
    } else {
        return false
    }
    const c = t[n]
    return c != '/' and c != '?' and c != '#' and c != ' '
}

fn starts_ci(s: []u8, prefix: []u8) bool {
    if (@len(s) < @len(prefix)) {
        return false
    }
    var i = 0
    while (i < @len(prefix)) {
        if (lower(s[i]) != lower(prefix[i])) {
            return false
        }
        i = i + 1
    }
    return true
}

fn hex_digit(c: u8) i64 {
    if (c >= '0' and c <= '9') {
        return @as(i64, c - '0')
    }
    if (c >= 'a' and c <= 'f') {
        return @as(i64, c - 'a') + 10
    }
    if (c >= 'A' and c <= 'F') {
        return @as(i64, c - 'A') + 10
    }
    return -1
}

// The byte at s[i] with a %XX escape decoded (a % without two hex digits
// stays as it is), and i past it.
fn decoded(s: []u8, inout i: i64) u8 {
    var c = s[i]
    if (c == '%' and i + 2 < @len(s) and hex_digit(s[i + 1]) >= 0 and hex_digit(s[i + 2]) >= 0) {
        c = @as(u8, hex_digit(s[i + 1]) * 16 + hex_digit(s[i + 2]))
        i = i + 2
    }
    i = i + 1
    return c
}

// A character of an HTTP token, which a field name is (RFC 9110, 5.6.2).
fn tchar(c: u8) bool {
    if ((c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9')) {
        return true
    }
    for ("!#$%&'*+-.^_`|~") |t| {
        if (c == t) {
            return true
        }
    }
    return false
}

// Does key, decoded, name a field, and value, decoded, hold no CR, LF or
// NUL (which would end the header early, or let a value write headers
// of its own)?
fn pair_ok(key: []u8, value: []u8) bool {
    if (@len(key) == 0) {
        return false
    }
    var i = 0
    while (i < @len(key)) {
        if (!tchar(decoded(key, &i))) {
            return false
        }
    }
    i = 0
    while (i < @len(value)) {
        const c = decoded(value, &i)
        if (c == '\r' or c == '\n' or c == 0) {
            return false
        }
    }
    return true
}

// Is key, decoded, Content-Type in any case? The exporter sends its own.
fn is_content_type(key: []u8) bool {
    const want = "content-type"
    var i = 0
    var k = 0
    while (i < @len(key)) {
        const c = decoded(key, &i)
        if (k >= @len(want) or lower(c) != want[k]) {
            return false
        }
        k = k + 1
    }
    return k == @len(want)
}

// Pair n of s's "key=value" pairs, as where its key and its value start
// and end in s (at: key from, key to, value from, value to), without the
// spaces around either; false past the last. Empty pairs ("a=1,,b=2")
// are skipped; a pair without "=" has an empty key.
fn pair_at(s: []u8, n: i64, inout lo: [4]i64) bool {
    var start = 0
    var k = 0
    while (start <= @len(s)) {
        const end = text.find_from(s, ",", start) orelse @len(s)
        var a = start
        var b = end
        while (a < b and (s[a] == ' ' or s[a] == '\t')) {
            a = a + 1
        }
        while (b > a and (s[b - 1] == ' ' or s[b - 1] == '\t')) {
            b = b - 1
        }
        if (b > a) {
            if (k == n) {
                const eq = text.find_from(s[0..b], "=", a) orelse a
                var ke = eq
                while (ke > a and (s[ke - 1] == ' ' or s[ke - 1] == '\t')) {
                    ke = ke - 1
                }
                var vs = if (eq == a) b else eq + 1
                while (vs < b and (s[vs] == ' ' or s[vs] == '\t')) {
                    vs = vs + 1
                }
                lo[0] = a
                lo[1] = if (eq == a) a else ke
                lo[2] = vs
                lo[3] = b
                return true
            }
            k = k + 1
        }
        start = end + 1
    }
    return false
}

// Whether s is an OTEL_EXPORTER_OTLP_HEADERS value parse_headers takes,
// found without allocating, so config_from_env can keep a good value
// over a bad one.
fn headers_ok(s: []u8) bool {
    var at: [4]i64 = @splat(0)
    var n = 0
    while (pair_at(s, n, &at)) {
        if (!pair_ok(s[at[0]..at[1]], s[at[2]..at[3]])) {
            return false
        }
        n = n + 1
    }
    return true
}

// s decoded at the end of out.
fn append_decoded(a: Allocator, inout out: Buf(u8), s: []u8) void {
    var i = 0
    while (i < @len(s)) {
        a.push(&out, decoded(s, &i))
    }
}

// The headers of an OTEL_EXPORTER_OTLP_HEADERS value as std/http takes
// them ("Authorization: Bearer abc\r\n" each); error.BadHeaders for a
// pair without "=", a name that is not an HTTP token, or a value that
// decodes to a CR, LF or NUL. Spaces around keys and values go; empty
// pairs ("a=1,,b=2") are skipped; a Content-Type is left out, since the
// body is JSON whatever a shared setting says.
fn parse_headers(a: Allocator, s: []u8) !Buf(u8) {
    if (!headers_ok(s)) {
        return error.BadHeaders
    }
    var out: Buf(u8) = .empty
    var at: [4]i64 = @splat(0)
    var n = 0
    while (pair_at(s, n, &at)) {
        const key = s[at[0]..at[1]]
        if (!is_content_type(key)) {
            append_decoded(a, &out, key)
            a.append_str(&out, ": ")
            append_decoded(a, &out, s[at[2]..at[3]])
            a.append_str(&out, "\r\n")
        }
        n = n + 1
    }
    return out
}
