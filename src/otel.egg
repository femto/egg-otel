// otel: OpenTelemetry traces for Egg. Spans go to a collector, or
// straight to a backend that takes OTLP (Better Stack, Honeycomb, Grafana
// Cloud...), over OTLP/HTTP (JSON), http:// or https://, batched by a
// thread of their own; W3C traceparent carries a trace from process to
// process. Configured as every OpenTelemetry SDK is, by OTEL_* variables:
//
//     const tp = try otel.provider(threads, net, files, a, clock, rng, otel.config_from_env(env, "my-service"))
//     defer tp.close()                    // after every tracer has closed;
//                                         // tp.shutdown() also says how it went
//     const tracer = tp.tracer()          // one per thread: tracer.clone()
//     defer tracer.close()
//
//     var span = tracer.start(a, "load user", .internal, parent)
//     defer tracer.finish(a, span)        // the compiler holds every path to it
//     span.set_int(a, "user.id", 42)
//
// A span is owned, so one that is never finished does not compile.
// finish hands it to the exporter without waiting: when the queue is
// full, the span is dropped rather than the request held up.
//
// Code that starts and finishes spans reads the clock and random bytes
// and sends on a channel, so its module declares `uses time, rand,
// thread`; making the provider needs net, fs (the system's roots, for
// https://) and alloc as well.
uses alloc, args, fs, net, rand, thread, time

const http = @import("std/http")
const sc = @import("context.egg")
const sp = @import("span.egg")
const otlp = @import("otlp.egg")
const cfgm = @import("config.egg")
const https = @import("tls/https")
const roots = @import("tls/roots")
const x509 = @import("tls/x509")

const SpanContext = sc.SpanContext
const Span = sp.Span
const Kind = sp.Kind

const VERSION = otlp.VERSION

const Config = cfgm.Config

fn config(service: str) Config {
    return cfgm.config(service)
}

fn config_from_env(env: Args, service: str) Config {
    return cfgm.config_from_env(env, service)
}

fn none() SpanContext {
    return sc.none()
}

fn parse_traceparent(s: []u8) ?SpanContext {
    return sc.parse_traceparent(s)
}

// What the exporter did, for shutdown to tell: spans the collector took,
// batches it did not (or that did not reach it), and the last of those:
// its HTTP status, or 0 when there was none (no connection, no TLS).
const Stats = struct {
    sent: i64
    failed_batches: i64
    failed_spans: i64
    last_status: i64
}

// The exporter thread and the sending end tracers clone.
const Provider = owned struct {
    worker: Thread
    tx: Sender(Span)
    stats: Receiver(Stats)
    clock: Clock
    rng: Random
    ratio: f64
    disabled: bool

    // A tracer for one thread; close it before shutdown.
    fn tracer(self: Provider) Tracer {
        return Tracer{ .tx = self.tx.clone(), .clock = self.clock, .rng = self.rng, .ratio = self.ratio, .disabled = self.disabled }
    }

    // shutdown, for a defer: what happened goes unread.
    fn close(sink self: Provider) void {
        _ = self.shutdown()
    }

    // Sends what is left, stops the exporter, and says how it went. It
    // waits for the last tracer to close: spans can come until then.
    fn shutdown(sink self: Provider) Stats {
        self.tx.close()
        self.worker.join()
        const s = self.stats.recv() orelse Stats{ .sent = 0, .failed_batches = 0, .failed_spans = 0, .last_status = 0 }
        self.stats.close()
        @forget(self)
        return s
    }
}

// The exporter for cfg, started. Fails with error.BadHeaders for headers
// that do not parse, and, for an https:// endpoint, as tls/roots does
// when the system's roots cannot be read (error.NoRoots).
//
// With the SDK disabled nothing is sampled, so nothing is sent: neither
// the headers nor the roots are looked at, and a bad setting left in the
// environment does not stop the program.
fn provider(threads: Threads, net: Net, files: Fs, a: Allocator, clock: Clock, rng: Random, cfg: Config) !Provider {
    var headers: Buf(u8) = .empty
    errdefer a.free(headers)
    if (!cfg.disabled) {
        a.free(@replace(&headers, try cfgm.parse_headers(a, cfg.headers)))
    }
    a.append_str(&headers, "Content-Type: application/json\r\n")
    const url = cfgm.traces_url(a, cfg)
    errdefer a.free(url)
    var trusted = x509.CertList.empty()
    errdefer a.free(trusted)
    if (!cfg.disabled and https.is_https(url)) {
        a.free(@replace(&trusted, try roots.system(a, files)))
    }
    const rx = threads.channel(Span, cfg.queue)
    const tx = rx.sender()
    const stats = threads.channel(Stats, 1)
    const worker = threads.spawn(export_loop, rx, stats.sender(), net, a, clock, rng, trusted, url, headers, cfg)
    return Provider{ .worker = worker, .tx = tx, .stats = stats, .clock = clock, .rng = rng, .ratio = cfg.ratio, .disabled = cfg.disabled }
}

const Tracer = owned struct {
    tx: Sender(Span)
    clock: Clock
    rng: Random
    ratio: f64
    disabled: bool

    // Another tracer on the same exporter, for another thread.
    fn clone(self: Tracer) Tracer {
        return Tracer{ .tx = self.tx.clone(), .clock = self.clock, .rng = self.rng, .ratio = self.ratio, .disabled = self.disabled }
    }

    fn close(sink self: Tracer) void {
        self.tx.close()
        @forget(self)
    }

    // A span started now, a child of parent (none() to start a trace).
    // A new trace is sampled at the configured ratio; a child is as its
    // parent is; with the SDK disabled, none is. A span that is not
    // sampled still has a context to pass on, but records nothing and is
    // never sent.
    fn start(self: Tracer, a: Allocator, name: []u8, kind: Kind, parent: SpanContext) Span {
        var c = sc.none()
        if (parent.valid) {
            c.trace_id = parent.trace_id
            // Disabled overrides even a sampled parent's choice.
            c.sampled = parent.sampled and !self.disabled
        } else {
            self.rng.fill(&c.trace_id[0..])
            if (sc.all_zero(c.trace_id[0..])) {
                c.trace_id[15] = 1
            }
            c.sampled = !self.disabled and sampled(c.trace_id, self.ratio)
        }
        self.rng.fill(&c.span_id[0..])
        if (sc.all_zero(c.span_id[0..])) {
            c.span_id[7] = 1
        }
        c.valid = true
        return Span{ .ctx = c, .parent = parent, .name = a.concat(name, ""), .kind = kind, .start = self.clock.now(), .end = 0, .attrs = .empty, .events = .empty, .status = .unset, .message = .empty }
    }

    // Ends the span now and hands it to the exporter, without waiting:
    // with the queue full, or the exporter gone, it is dropped.
    fn finish(self: Tracer, a: Allocator, sink span: Span) void {
        if (!span.recording()) {
            a.free(span)
            return
        }
        var s = span
        s.end = self.clock.now()
        switch (self.tx.try_send(s)) {
            .sent => {}
            .full => |back| {
                a.free(back)
            }
            .closed => |back| {
                a.free(back)
            }
        }
    }

    // An event at this moment in span's life.
    fn event(self: Tracer, a: Allocator, inout span: Span, name: []u8) void {
        if (span.recording()) {
            a.push(&span.events, sp.Event{ .name = a.concat(name, ""), .time = self.clock.now(), .attrs = .empty })
        }
    }

    // A server span for an HTTP request, a child of the traceparent it
    // came with (if any), named by its method as OTel's HTTP conventions
    // say when the route is not known (rename it to "GET /users/{id}").
    fn server_span(self: Tracer, a: Allocator, req: http.Request) Span {
        const parent = sc.parse_traceparent(http.header(req, "traceparent") orelse "") orelse sc.none()
        var s = self.start(a, req.method, .server, parent)
        s.set_text(a, "http.request.method", req.method)
        s.set_text(a, "url.scheme", "http")
        s.set_text(a, "url.path", req.path)
        if (@len(req.query) > 0) {
            s.set_text(a, "url.query", req.query)
        }
        if (@len(req.host) > 0) {
            s.set_text(a, "server.address", req.host)
        }
        if (@len(req.peer_ip) > 0) {
            s.set_text(a, "client.address", req.peer_ip)
        }
        return s
    }

    // A client span for a request this program makes; put its context in
    // the request's headers with inject.
    fn client_span(self: Tracer, a: Allocator, method: []u8, url: []u8, parent: SpanContext) Span {
        var s = self.start(a, method, .client, parent)
        s.set_text(a, "http.request.method", method)
        s.set_text(a, "url.full", url)
        return s
    }
}

// The status of an HTTP response on its span: a server's 5xx is an error,
// a client's 4xx and 5xx (OTel's HTTP conventions).
fn http_status(a: Allocator, inout span: Span, code: i64) void {
    span.set_int(a, "http.response.status_code", code)
    const limit = if (span.kind == .client) 400 else 500
    if (code >= limit) {
        span.fail(a, "")
    }
}

// "traceparent: ...\r\n" for c at the end of headers, as std/http's
// fetch and send_request take them; nothing for a context that is not
// valid.
fn inject(a: Allocator, inout headers: Buf(u8), c: SpanContext) void {
    if (!c.valid) {
        return
    }
    a.append_str(&headers, "traceparent: ")
    sc.append_traceparent(a, &headers, c)
    a.append_str(&headers, "\r\n")
}

// TraceIdRatioBased: the trace id's last 8 bytes, as a number below
// 2^63, under ratio of 2^63; so every service decides the same for a
// trace. Compared as integers: an f64 rounds ids near the bound onto it.
fn sampled(id: [16]u8, ratio: f64) bool {
    if (ratio >= 1.0) {
        return true
    }
    if (ratio <= 0.0) {
        return false
    }
    const bound = @as(u64, ratio * 9223372036854775808.0)
    var x: u64 = 0
    var i = 8
    while (i < 16) {
        x = (x << 8) | @as(u64, id[i])
        i = i + 1
    }
    return (x >> 1) < bound
}

// The exporter thread: spans into batches, a batch to the collector when
// it is full or interval_ms after the last one went, and what is left
// when every sender has closed; then how it went, on done.
fn export_loop(sink rx: Receiver(Span), sink done: Sender(Stats), net: Net, a: Allocator, clock: Clock, rng: Random, sink trusted: x509.CertList, sink url: Buf(u8), sink headers: Buf(u8), cfg: Config) void {
    defer rx.close()
    defer done.close()
    defer a.free(trusted)
    defer a.free(url)
    defer a.free(headers)
    var batch: Buf(Span) = .empty
    defer a.free(batch)
    var stats = Stats{ .sent = 0, .failed_batches = 0, .failed_spans = 0, .last_status = 0 }
    const out = Out{ .net = net, .clock = clock, .rng = rng }
    var last = clock.monotonic()
    while (true) {
        const waited = (clock.monotonic() - last) / 1000000
        const left = if (waited >= cfg.interval_ms) 0 else cfg.interval_ms - waited
        select {
            rx => |s| {
                a.push(&batch, s)
                if (@len(batch) >= cfg.batch) {
                    send_batch(out, a, trusted, url, headers, cfg, &batch, &stats)
                    last = clock.monotonic()
                }
            }
            timeout(left) => {
                if (@len(batch) > 0) {
                    send_batch(out, a, trusted, url, headers, cfg, &batch, &stats)
                }
                last = clock.monotonic()
            }
            closed => {
                break
            }
        }
    }
    if (@len(batch) > 0) {
        send_batch(out, a, trusted, url, headers, cfg, &batch, &stats)
    }
    done.send(stats)
}

// What a request to the collector needs besides the allocator.
const Out = struct {
    net: Net
    clock: Clock
    rng: Random
}

// One POST of the batch, which is emptied whether it got there or not:
// telemetry that cannot be sent is let go, not kept to grow.
fn send_batch(out: Out, a: Allocator, trusted: x509.CertList, url: []u8, headers: []u8, cfg: Config, inout batch: Buf(Span), inout stats: Stats) void {
    const n = @len(batch)
    const body = otlp.encode(a, cfg.service, batch[0..])
    defer a.free(body)
    a.free(@take(&batch))
    var opts = http.options()
    opts.timeout_ms = cfg.timeout_ms
    const r = https.fetch(out.net, a, out.rng, out.clock, trusted, "POST", url, headers, body, opts) catch {
        stats.failed_batches = stats.failed_batches + 1
        stats.failed_spans = stats.failed_spans + n
        stats.last_status = 0
        return
    }
    if (r.status >= 200 and r.status < 300) {
        // A 2xx may still say some were not taken (OTLP's partial success).
        const rejected = otlp.rejected_spans(r.body, n)
        stats.sent = stats.sent + n - rejected
        if (rejected > 0) {
            stats.failed_batches = stats.failed_batches + 1
            stats.failed_spans = stats.failed_spans + rejected
            stats.last_status = r.status
        }
    } else {
        stats.failed_batches = stats.failed_batches + 1
        stats.failed_spans = stats.failed_spans + n
        stats.last_status = r.status
    }
    r.deinit(a)
}
