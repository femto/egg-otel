// OTEL_SDK_DISABLED: nothing is sampled, not even a child of a sampled
// parent from another process, and nothing is sent. The endpoint is a
// closed port, so a span that went would show as failed.
uses alloc, fs, io, net, rand, thread, time

const otel = @import("otel")

fn main(io: Io, net: Net, files: Fs, a: Allocator, threads: Threads, clock: Clock, rng: Random) !void {
    var cfg = otel.config("disabled-test")
    cfg.endpoint = "http://127.0.0.1:9"
    cfg.disabled = true
    const tp = try otel.provider(threads, net, files, a, clock, rng, cfg)
    const tracer = tp.tracer()
    const remote = otel.parse_traceparent("00-0af7651916cd43dd8448eb211c80319c-b7ad6b7169203331-01") orelse otel.none()
    io.print("parent sampled: ", remote.sampled)
    var child = tracer.start(a, "child", .server, remote)
    io.print("child sampled: ", child.context().sampled, ", recording: ", child.recording())
    // Its context still goes on, for the services after it.
    io.print("same trace: ", child.context().trace_id[0] == remote.trace_id[0] and child.context().trace_id[15] == remote.trace_id[15])
    child.set_int(a, "n", 1)
    tracer.finish(a, child)
    const root = tracer.start(a, "root", .internal, otel.none())
    io.print("root sampled: ", root.context().sampled)
    tracer.finish(a, root)
    tracer.close()
    const stats = tp.shutdown()
    io.print("sent ", stats.sent, ", failed ", stats.failed_spans)
}
