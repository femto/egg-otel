// The whole way: spans from a tracer, batched by the exporter thread and
// POSTed to a collector, here a thread of this test that keeps what it
// gets. Batches of 2: three spans make one full batch, and the third goes
// at shutdown. A trace sampled out sends nothing.
uses alloc, fs, io, net, rand, thread, time

const http = @import("std/http")
const text = @import("std/text")
const otel = @import("otel")

// Answers n requests with 200, sending each body back to the test.
fn collector(sink server: TcpListener, a: Allocator, sink out: Sender(Buf(u8)), n: i64) void {
    defer server.close()
    defer out.close()
    var i = 0
    while (i < n) {
        const c = server.accept() catch {
            return
        }
        defer c.close()
        var inbox: Buf(u8) = .empty
        defer a.free(inbox)
        const req = (http.read_request(c, a, &inbox, 1048576) catch {
            return
        }) orelse return
        defer req.deinit(a)
        // The first batch is taken but for one span (OTLP's partial
        // success, with a 200).
        const answer = if (i == 0) "{\"partialSuccess\":{\"rejectedSpans\":\"1\",\"errorMessage\":\"too old\"}}" else "{}"
        http.respond(c, a, req, "200 OK", "", "Content-Type: application/json\r\n", answer) catch {}
        out.send(a.concat(req.method, " ", req.path, " ", req.content_type, " ", req.body))
        i = i + 1
    }
}

fn count(s: []u8, needle: []u8) i64 {
    var n = 0
    var from = 0
    while (text.find_from(s, needle, from)) |i| {
        n = n + 1
        from = i + @len(needle)
    }
    return n
}

fn main(io: Io, net: Net, files: Fs, a: Allocator, threads: Threads, clock: Clock, rng: Random) !void {
    const server = try net.tcp_listen("127.0.0.1", 0)
    const port = server.port()
    const digits = a.int_str(port)
    const url = a.concat("http://127.0.0.1:", digits)
    a.free(digits)
    const endpoint = a.leak(url)
    a.free(url)
    var cfg = otel.config("export-test")
    cfg.endpoint = endpoint
    cfg.batch = 2
    cfg.interval_ms = 60000
    const tp = otel.provider(threads, net, files, a, clock, rng, cfg) catch |e| {
        server.close()
        return e
    }
    const bodies = threads.channel(Buf(u8), 4)
    const got = threads.spawn(collector, server, a, bodies.sender(), 2)
    const tracer = tp.tracer()

    var root = tracer.start(a, "root", .server, otel.none())
    const root_ctx = root.context()
    var child = tracer.start(a, "child", .internal, root_ctx)
    child.set_int(a, "n", 1)
    tracer.event(a, &child, "halfway")
    const child_ctx = child.context()
    tracer.finish(a, child)
    var grandchild = tracer.start(a, "grandchild", .client, child_ctx)
    otel.http_status(a, &grandchild, 404)
    tracer.finish(a, grandchild)
    root.ok()
    tracer.finish(a, root)
    // Sampled out: neither it nor its child is sent.
    var off = otel.none()
    off.trace_id = @splat(7)
    off.span_id = @splat(9)
    off.valid = true
    off.sampled = false
    const quiet = tracer.start(a, "quiet", .server, off)
    io.print("quiet recording: ", quiet.recording())
    tracer.finish(a, tracer.start(a, "quiet child", .internal, quiet.context()))
    tracer.finish(a, quiet)

    tracer.close()
    const stats = tp.shutdown()
    io.print("stats: sent ", stats.sent, ", failed ", stats.failed_spans, " spans in ", stats.failed_batches, " batch, last status ", stats.last_status)
    got.join()

    var all: Buf(u8) = .empty
    defer a.free(all)
    var requests = 0
    while (bodies.recv()) |b| {
        requests = requests + 1
        io.print(text.starts_with(b, "POST /v1/traces application/json {\"resourceSpans\""))
        a.append_str(&all, b)
        a.free(b)
    }
    bodies.close()
    io.print("requests: ", requests)
    io.print("spans: ", count(all, "\"spanId\""))
    io.print("roots: ", count(all, "\"spanId\"") - count(all, "\"parentSpanId\""))
    io.print("root ", count(all, "\"name\":\"root\""), ", child ", count(all, "\"name\":\"child\""), ", grandchild ", count(all, "\"name\":\"grandchild\""), ", quiet ", count(all, "quiet"))
    const trace = try trace_hex(a, root_ctx)
    defer a.free(trace)
    io.print("one trace: ", count(all, "\"traceId\""), " ", count(all, trace))
    io.print("event: ", count(all, "\"name\":\"halfway\""))
    io.print("statuses: ok ", count(all, "\"code\":1"), ", error ", count(all, "\"code\":2"))
}

fn trace_hex(a: Allocator, c: otel.SpanContext) !Buf(u8) {
    var out: Buf(u8) = .empty
    otel.inject(a, &out, c)
    // "traceparent: 00-<trace>-..." : the trace id is 32 hex at 16.
    const id = a.concat("\"traceId\":\"", out[16..48], "\"")
    a.free(out)
    return id
}
